{
    // simplify layout
    "window.commandCenter": false,
    "window.menuBarVisibility": "compact",
    "breadcrumbs.enabled": false,
    "workbench.tree.renderIndentGuides": "onHover",
    "workbench.browser.showInTitleBar": false,
    "workbench.layoutControl.enabled": false,
    "workbench.activityBar.location": "top",
    "chat.titleBar.signIn.enabled": false,
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "explorer.compactFolders": false,
    "editor.minimap.enabled": false,
    "editor.scrollBeyondLastLine": false,

    // disable stickyScroll
    "terminal.integrated.stickyScroll.enabled": false,
    "workbench.tree.enableStickyScroll": false,
    "editor.stickyScroll.enabled": false,

    // make smooth
    "workbench.list.smoothScrolling": true,
    "workbench.editor.showTabs": "multiple",
    "workbench.editor.tabActionCloseVisibility": true,
    "workbench.list.fastScrollSensitivity": 5,
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.smoothScrolling": true,
    "editor.fastScrollSensitivity": 5,
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.gpuAcceleration": "auto",
    
    // fonts
    "editor.fontFamily": "'JetBrainsMono Nerd Font', Consolas, 'Courier New', monospace",
    "editor.fontSize": 13,
    "editor.fontWeight": "400",
    "editor.fontLigatures": true,
    "editor.lineHeight": 1.2,
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', Consolas, 'Courier New', monospace",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.fontWeight": "400",
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.lineHeight": 1.2,

    // coding experience
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "workbench.editor.enablePreview": false,
    "explorer.autoReveal": false,
    "explorer.confirmDelete": true,
    "explorer.confirmDragAndDrop": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.renderWhitespace": "selection",
    "terminal.integrated.shellIntegration.enabled": true,

    // enhance search
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/build": true
    },

    // external theme
    "workbench.iconTheme": "material-icon-theme",

    // other configs
    "security.allowedUNCHosts": [
        "wsl.localhost"
    ],
}